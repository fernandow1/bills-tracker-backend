DB_ROOT_PASSWORD=<YOUR_DB_ROOT_PASSWORD>
MYSQLDATABASE=bills-tracker
MYSQLUSER=app_user
MYSQLPASSWORD=<YOUR_DB_PASSWORD>
MYSQLHOST=localhost
MYSQLPORT=3308
PORT=3000
JWT_SECRET=<YOUR_JWT_SECRET>

NODE_ENV=development

# Redis (local development)
REDIS_URL=redis://localhost:6379

# BetterStack Logging (production only - paste your token here)
# BETTERSTACK_SOURCE_TOKEN=your_token_here
# BETTERSTACK_ENDPOINT=https://in.logs.betterstack.com  # Optional: override default endpoint

REMOTE_MYSQLDATABASE=<REMOTE_DB_NAME>
REMOTE_MYSQLUSER=<REMOTE_DB_USER>
REMOTE_MYSQLPASSWORD=<REMOTE_DB_PASSWORD>
REMOTE_MYSQLHOST=<REMOTE_DB_HOST>
REMOTE_MYSQLPORT=3306

GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# K6 Load Testing config
TEST_API_TOKEN=<TU_TOKEN_JWT_AQUI>
