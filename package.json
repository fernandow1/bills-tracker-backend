{
  "name": "bills-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "build:full": "tsc && tsc-alias",
    "build": "npm run build:full",
    "serve": "nodemon",
    "migration:generate": "node load-schema.js && atlas migrate diff --dir \"file://migrations\" --to \"file://schema.sql\" --dev-url \"docker://mysql/8/dev\"",
    "migration:run": "atlas migrate apply --dir \"file://migrations\" --env typeorm",
    "migration:status": "atlas migrate status --dir \"file://migrations\" --env typeorm",
    "remotemigration:run": "atlas migrate apply --dir \"file://migrations\" --url \"mysql://${REMOTE_DB_USER}:${REMOTE_DB_PASSWORD}@${REMOTE_DB_HOST}:${REMOTE_DB_PORT}/${REMOTE_DB_NAME}\"",
    "test:migration:run": "atlas migrate apply --dir \"file://migrations\" --url \"mysql://${TEST_DB_USER}:${TEST_DB_PASSWORD}@${TEST_DB_HOST}:${TEST_DB_PORT}/${TEST_DB_NAME}\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "start": "node dist/app.js",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load:basic": "docker compose --profile testing run --rm k6 run /tests/basic.js",
    "test:load:bills": "docker compose --profile testing run --rm k6 run /tests/bills.js"
  },
  "keywords": [],
  "author": "Fernando Wabab",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@google/genai": "^1.44.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.0",
    "env-var": "^7.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.14.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.25",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@ariga/atlas-provider-typeorm": "^0.3.2",
    "@eslint/js": "^9.32.0",
    "@faker-js/faker": "^7.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/k6": "^1.7.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "chokidar": "^4.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
