# Usamos $binary_remote_addr para ahorrar espacio.
# rate=5r/s significa que permitimos 5 peticiones por segundo.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=5r/s;

server {
    listen $PORT;

    error_page 429 = @429;

    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;

    # Si tu backend de Node espera el prefijo /api, usa esto:
    location /api/ {
        # 1. Manejo de Preflight (OPTIONS)
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' 'https://your-frontend-domain.com' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE, PATCH' always;
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        # 2. Headers para la petición real (POST, GET, etc.)
        add_header 'Access-Control-Allow-Origin' 'https://your-frontend-domain.com' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE, PATCH' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;    

        # 3. Configuración del Proxy (Aseguramos el paso a Node)
        limit_req zone=api_limit burst=10 nodelay;
                
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $upstream_endpoint "http://${UPSTREAM_URL}";
        proxy_pass $upstream_endpoint;

        # Optimizaciones para el túnel de conexión
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;

        # Timeouts un poco más largos por si el login es pesado
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location /health {
        proxy_pass http://${UPSTREAM_URL};
    }

    location @429 {
        default_type application/json;
        add_header Retry-After 1;
        return 429 '{"message": "Too many requests. Please try again later."}';
    }
}
